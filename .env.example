ECONOMIC_APP_SECRET_TOKEN=
ECONOMIC_AGREEMENT_GRANT_TOKEN=
ECONOMIC_APP_PUBLIC_TOKEN=
ECONOMIC_INSTALLATION_URL=
ECONOMIC_ENABLE_WRITES=false
ECONOMIC_AUDIT_LOG=
ECONOMIC_POLICY_PATH=
# Signing secret for prepared operations; random per process when empty.
ECONOMIC_PREPARE_SECRET=
# Upstream request timeout in milliseconds (1-600000).
ECONOMIC_TIMEOUT_MS=30000

# Streamable HTTP transport. Binds to loopback by default.
MCP_HTTP_HOST=127.0.0.1
PORT=3000
MCP_MAX_BODY_BYTES=10485760
# Bearer token for /mcp: at least 32 printable ASCII characters
# (e.g. `openssl rand -hex 32`). Required when MCP_HTTP_HOST is not a loopback
# address and when MCP_ALLOW_ANY_ORIGIN=true; the server refuses to start
# otherwise.
MCP_HTTP_TOKEN=
# Start without a token where one would be required. Only when access is
# restricted by other means.
MCP_HTTP_ALLOW_UNAUTHENTICATED=false
MCP_ALLOWED_ORIGINS=
MCP_ALLOW_ANY_ORIGIN=false
# Host header allowlist (host names, no port). Default: localhost names on a
# loopback bind, no check otherwise.
MCP_ALLOWED_HOSTS=
# Failed auth attempts per client address per window before 429; 0 disables.
MCP_AUTH_FAILURE_LIMIT=20
MCP_AUTH_FAILURE_WINDOW_MS=60000
